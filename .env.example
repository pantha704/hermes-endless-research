# =============================================================================
# hermes-endless-research — environment template
#
# Copy this file to `.env` and fill in ONLY what you use. Do NOT commit `.env`.
# The endless-research engine itself stores no secrets; these are the secrets
# that the host Hermes install / providers need.
#
# NEVER commit real values. Keep this file as the template only.
# =============================================================================

# --- Hermes provider credentials (the model / web-research backend) ---------
# Add the environment variables your Hermes provider reads. Examples:
#   OPENAI_API_KEY=
#   ANTHROPIC_API_KEY=
#   DEEPSEEK_API_KEY=
#   OPENROUTER_API_KEY=
# (Hermes normally stores keys in ~/.hermes/.env — see its own docs.)

# General web-search / extraction API keys, if your tooling uses them:
#   SERPAPI_KEY=
#   SCRAPINGBEE_KEY=

# --- Optional: Hermes home override ------------------------------------------
# Leave unset to use the default $HOME/.hermes
# HERMES_HOME=

# --- Optional: install prefix for the CLI launcher ---------------------------
# Leave unset to use ~/.local
# PREFIX=
